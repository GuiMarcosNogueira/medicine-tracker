{
  "expo": {
    "name": "MedStock",
    "slug": "medstock",
    "version": "1.0.0",
    "scheme": "medstock",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medstock.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MedStock precisa da câmera para ler rótulos e códigos de barras de medicamentos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.medstock.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "MedStock precisa da câmera para ler rótulos.",
          "enableCodeScanner": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "127c6abc-200f-4006-97a9-5742a12f42a8"
      }
    }
  }
}
